# LearnX Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# Model API Configuration
# ============================================================================

# Required: your OpenAI API key (any value works for a local OpenAI-compatible
# server such as Ollama, which ignores it)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: the model the application uses (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional: alternative model for A/B testing (default: gpt-3.5-turbo)
# Note: OpenAI retires gpt-3.5-turbo on 23 October 2026
OPENAI_ALTERNATIVE_MODEL=gpt-3.5-turbo

# Optional: OpenAI-compatible endpoint. Set this to use a local model server.
# Start Ollama with a context window large enough for the planning prompts:
#   OLLAMA_CONTEXT_LENGTH=32768 ollama serve
# OPENAI_BASE_URL=http://localhost:11434/v1

# Optional: organisation and project, if your account uses them
# OPENAI_ORG=
# OPENAI_PROJECT=


# ============================================================================
# Sampling and reproducibility
# ============================================================================

# Use temperature 0 and a fixed seed at every call site (default: false).
# The experiment runner sets this itself; set it here only to make the
# application deterministic as well.
# LEARNX_DETERMINISTIC=false

# Set to false for backends that reject the temperature parameter, so it is
# omitted rather than refused (default: true).
# LLM_SUPPORTS_TEMPERATURE=true

# Reasoning effort for reasoning-capable models (e.g. none, low, medium, high).
# Leave unset for the model's own default. Note that some models accept a
# temperature only when reasoning is explicitly off.
# LLM_REASONING_EFFORT=


# ============================================================================
# Request handling
# ============================================================================

# Retry delay in seconds (default: 1.0)
RETRY_DELAY=1.0

# Request timeout in seconds (default: 60.0). Local models need far more; the
# experiment runner uses 900 for them.
REQUEST_TIMEOUT=60.0

# Retry backoff multiplier (default: 2.0)
RETRY_BACKOFF=2.0


# ============================================================================
# Cost reporting (USD per 1000 tokens, used by the token tracker)
# ============================================================================

# COST_PER_1K_INPUT=0.0015
# COST_PER_1K_OUTPUT=0.0020
# ALT_COST_PER_1K_INPUT=0.00015
# ALT_COST_PER_1K_OUTPUT=0.0006
